<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CustomTailoring" targetNamespace="https://example.org/atelier" exporter="Atelier Telegram Shop">
  <ns0:process id="CustomTailoring" name="Индивидуальный пошив" isExecutable="false">
    <ns0:startEvent id="start2" name="Начало">
      <ns0:outgoing>t1</ns0:outgoing>
    </ns0:startEvent>
    <ns0:task id="request" name="Пожелания и мерки">
      <ns0:incoming>t1</ns0:incoming>
      <ns0:outgoing>t2</ns0:outgoing>
    </ns0:task>
    <ns0:task id="quote" name="Обсуждение с менеджером, расчёт цены">
      <ns0:incoming>t2</ns0:incoming>
      <ns0:outgoing>t3</ns0:outgoing>
    </ns0:task>
    <ns0:exclusiveGateway id="approve" name="Клиент согласен с ценой?">
      <ns0:incoming>t3</ns0:incoming>
      <ns0:outgoing>t4</ns0:outgoing>
      <ns0:outgoing>t6</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:task id="reject" name="Отмена заявки">
      <ns0:incoming>t4</ns0:incoming>
      <ns0:outgoing>t5</ns0:outgoing>
    </ns0:task>
    <ns0:endEvent id="cancelled" name="Заявка закрыта">
      <ns0:incoming>t5</ns0:incoming>
    </ns0:endEvent>
    <ns0:task id="confirmed" name="Подтверждение">
      <ns0:incoming>t6</ns0:incoming>
      <ns0:outgoing>t7</ns0:outgoing>
    </ns0:task>
    <ns0:task id="produce" name="Пошив">
      <ns0:incoming>t7</ns0:incoming>
      <ns0:outgoing>t8</ns0:outgoing>
    </ns0:task>
    <ns0:task id="handoff" name="Самовывоз у м. Беляево">
      <ns0:incoming>t8</ns0:incoming>
      <ns0:outgoing>t9</ns0:outgoing>
    </ns0:task>
    <ns0:endEvent id="done" name="Завершение">
      <ns0:incoming>t9</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="t1" sourceRef="start2" targetRef="request" />
    <ns0:sequenceFlow id="t2" sourceRef="request" targetRef="quote" />
    <ns0:sequenceFlow id="t3" sourceRef="quote" targetRef="approve" />
    <ns0:sequenceFlow id="t4" sourceRef="approve" targetRef="reject" name="Нет" />
    <ns0:sequenceFlow id="t5" sourceRef="reject" targetRef="cancelled" />
    <ns0:sequenceFlow id="t6" sourceRef="approve" targetRef="confirmed" name="Да" />
    <ns0:sequenceFlow id="t7" sourceRef="confirmed" targetRef="produce" />
    <ns0:sequenceFlow id="t8" sourceRef="produce" targetRef="handoff" />
    <ns0:sequenceFlow id="t9" sourceRef="handoff" targetRef="done" />
  </ns0:process>
  <ns1:BPMNDiagram id="Diagram_CustomTailoring">
    <ns1:BPMNPlane id="Plane_CustomTailoring" bpmnElement="CustomTailoring">
      <ns1:BPMNShape id="start2_di" bpmnElement="start2">
        <ns2:Bounds x="40" y="170" width="36" height="36" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="request_di" bpmnElement="request">
        <ns2:Bounds x="135" y="150" width="130" height="76" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="quote_di" bpmnElement="quote">
        <ns2:Bounds x="335" y="150" width="130" height="76" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="approve_di" bpmnElement="approve">
        <ns2:Bounds x="540" y="160" width="50" height="50" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="reject_di" bpmnElement="reject">
        <ns2:Bounds x="660" y="290" width="130" height="76" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="cancelled_di" bpmnElement="cancelled">
        <ns2:Bounds x="870" y="310" width="36" height="36" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="confirmed_di" bpmnElement="confirmed">
        <ns2:Bounds x="660" y="150" width="130" height="76" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="produce_di" bpmnElement="produce">
        <ns2:Bounds x="850" y="150" width="130" height="76" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="handoff_di" bpmnElement="handoff">
        <ns2:Bounds x="1040" y="150" width="130" height="76" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="done_di" bpmnElement="done">
        <ns2:Bounds x="1230" y="170" width="36" height="36" />
      </ns1:BPMNShape>
      <ns1:BPMNEdge id="t1_di" bpmnElement="t1">
        <ns3:waypoint x="76" y="188.0" />
        <ns3:waypoint x="135" y="188.0" />
      </ns1:BPMNEdge>
      <ns1:BPMNEdge id="t2_di" bpmnElement="t2">
        <ns3:waypoint x="265" y="188.0" />
        <ns3:waypoint x="335" y="188.0" />
      </ns1:BPMNEdge>
      <ns1:BPMNEdge id="t3_di" bpmnElement="t3">
        <ns3:waypoint x="465" y="188.0" />
        <ns3:waypoint x="540" y="185.0" />
      </ns1:BPMNEdge>
      <ns1:BPMNEdge id="t4_di" bpmnElement="t4">
        <ns3:waypoint x="590" y="185.0" />
        <ns3:waypoint x="660" y="328.0" />
      </ns1:BPMNEdge>
      <ns1:BPMNEdge id="t5_di" bpmnElement="t5">
        <ns3:waypoint x="790" y="328.0" />
        <ns3:waypoint x="870" y="328.0" />
      </ns1:BPMNEdge>
      <ns1:BPMNEdge id="t6_di" bpmnElement="t6">
        <ns3:waypoint x="590" y="185.0" />
        <ns3:waypoint x="660" y="188.0" />
      </ns1:BPMNEdge>
      <ns1:BPMNEdge id="t7_di" bpmnElement="t7">
        <ns3:waypoint x="790" y="188.0" />
        <ns3:waypoint x="850" y="188.0" />
      </ns1:BPMNEdge>
      <ns1:BPMNEdge id="t8_di" bpmnElement="t8">
        <ns3:waypoint x="980" y="188.0" />
        <ns3:waypoint x="1040" y="188.0" />
      </ns1:BPMNEdge>
      <ns1:BPMNEdge id="t9_di" bpmnElement="t9">
        <ns3:waypoint x="1170" y="188.0" />
        <ns3:waypoint x="1230" y="188.0" />
      </ns1:BPMNEdge>
    </ns1:BPMNPlane>
  </ns1:BPMNDiagram>
</ns0:definitions>