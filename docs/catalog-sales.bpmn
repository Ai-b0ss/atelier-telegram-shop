<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CatalogSales" targetNamespace="https://example.org/atelier" exporter="Atelier Telegram Shop"><bpmn:process id="CatalogSales" name="Продажа изделий из каталога" isExecutable="false"><bpmn:startEvent id="start" name="Начало"><bpmn:outgoing>c1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="browse" name="Просмотр каталога"><bpmn:incoming>c1</bpmn:incoming><bpmn:outgoing>c2</bpmn:outgoing><bpmn:incoming>c8</bpmn:incoming></bpmn:task><bpmn:task id="cart" name="Корзина"><bpmn:incoming>c2</bpmn:incoming><bpmn:outgoing>c3</bpmn:outgoing></bpmn:task><bpmn:task id="contact" name="Контакты и доставка"><bpmn:incoming>c3</bpmn:incoming><bpmn:outgoing>c4</bpmn:outgoing></bpmn:task><bpmn:task id="checkout" name="Создание заказа и списание остатков"><bpmn:incoming>c4</bpmn:incoming><bpmn:outgoing>c5</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="stock" name="Товар в наличии?"><bpmn:incoming>c5</bpmn:incoming><bpmn:outgoing>c6</bpmn:outgoing><bpmn:outgoing>c7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="retry" name="Изменить заказ"><bpmn:incoming>c7</bpmn:incoming><bpmn:outgoing>c8</bpmn:outgoing></bpmn:task><bpmn:task id="confirmation" name="Подтверждение менеджером"><bpmn:incoming>c6</bpmn:incoming><bpmn:outgoing>c9</bpmn:outgoing></bpmn:task><bpmn:task id="sewing" name="Подготовка изделия"><bpmn:incoming>c9</bpmn:incoming><bpmn:outgoing>c10</bpmn:outgoing></bpmn:task><bpmn:task id="delivery" name="Выдача/доставка"><bpmn:incoming>c10</bpmn:incoming><bpmn:outgoing>c11</bpmn:outgoing></bpmn:task><bpmn:endEvent id="finish" name="Заказ завершён"><bpmn:incoming>c11</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="c1" sourceRef="start" targetRef="browse" /><bpmn:sequenceFlow id="c2" sourceRef="browse" targetRef="cart" /><bpmn:sequenceFlow id="c3" sourceRef="cart" targetRef="contact" /><bpmn:sequenceFlow id="c4" sourceRef="contact" targetRef="checkout" /><bpmn:sequenceFlow id="c5" sourceRef="checkout" targetRef="stock" /><bpmn:sequenceFlow id="c6" sourceRef="stock" targetRef="confirmation" /><bpmn:sequenceFlow id="c7" sourceRef="stock" targetRef="retry" /><bpmn:sequenceFlow id="c8" sourceRef="retry" targetRef="browse" /><bpmn:sequenceFlow id="c9" sourceRef="confirmation" targetRef="sewing" /><bpmn:sequenceFlow id="c10" sourceRef="sewing" targetRef="delivery" /><bpmn:sequenceFlow id="c11" sourceRef="delivery" targetRef="finish" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_CatalogSales"><bpmndi:BPMNPlane id="Plane_CatalogSales" bpmnElement="CatalogSales"><bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="40" y="170" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="browse_di" bpmnElement="browse"><dc:Bounds x="125" y="150" width="130" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="cart_di" bpmnElement="cart"><dc:Bounds x="305" y="150" width="130" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="contact_di" bpmnElement="contact"><dc:Bounds x="485" y="150" width="130" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="checkout_di" bpmnElement="checkout"><dc:Bounds x="665" y="150" width="130" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="stock_di" bpmnElement="stock"><dc:Bounds x="850" y="160" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="retry_di" bpmnElement="retry"><dc:Bounds x="960" y="295" width="130" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="confirmation_di" bpmnElement="confirmation"><dc:Bounds x="960" y="150" width="130" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="sewing_di" bpmnElement="sewing"><dc:Bounds x="1140" y="150" width="130" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="delivery_di" bpmnElement="delivery"><dc:Bounds x="1320" y="150" width="130" height="76" /><