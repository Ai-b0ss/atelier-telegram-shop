<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CustomTailoring" targetNamespace="https://example.org/atelier" exporter="Atelier Telegram Shop"><bpmn:process id="CustomTailoring" name="Индивидуальный пошив" isExecutable="false"><bpmn:startEvent id="start2" name="Начало"><bpmn:outgoing>t1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="request" name="Пожелания и мерки"><bpmn:incoming>t1</bpmn:incoming><bpmn:outgoing>t2</bpmn:outgoing></bpmn:task><bpmn:task id="quote" name="Расчёт цены и себестоимости"><bpmn:incoming>t2</bpmn:incoming><bpmn:outgoing>t3</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="approve" name="Клиент согласен?"><bpmn:incoming>t3</bpmn:incoming><bpmn:outgoing>t4</bpmn:outgoing><bpmn:outgoing>t6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="reject" name="Отмена заявки"><bpmn:incoming>t4</bpmn:incoming><bpmn:outgoing>t5</bpmn:outgoing></bpmn:task><bpmn:endEvent id="cancelled" name="Заявка закрыта"><bpmn:incoming>t5</bpmn:incoming></bpmn:endEvent><bpmn:task id="confirmed" name="Подтверждение"><bpmn:incoming>t6</bpmn:incoming><bpmn:outgoing>t7</bpmn:outgoing></bpmn:task><bpmn:task id="produce" name="Пошив"><bpmn:incoming>t7</bpmn:incoming><bpmn:outgoing>t8</bpmn:outgoing></bpmn:task><bpmn:task id="handoff" name="Передача изделия"><bpmn:incoming>t8</bpmn:incoming><bpmn:outgoing>t9</bpmn:outgoing></bpmn:task><bpmn:endEvent id="done" name="Завершение"><bpmn:incoming>t9</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="t1" sourceRef="start2" targetRef="request" /><bpmn:sequenceFlow id="t2" sourceRef="request" targetRef="quote" /><bpmn:sequenceFlow id="t3" sourceRef="quote" targetRef="approve" /><bpmn:sequenceFlow id="t4" sourceRef="approve" targetRef="reject" /><bpmn:sequenceFlow id="t5" sourceRef="reject" targetRef="cancelled" /><bpmn:sequenceFlow id="t6" sourceRef="approve" targetRef="confirmed" /><bpmn:sequenceFlow id="t7" sourceRef="confirmed" targetRef="produce" /><bpmn:sequenceFlow id="t8" sourceRef="produce" targetRef="handoff" /><bpmn:sequenceFlow id="t9" sourceRef="handoff" targetRef="done" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_CustomTailoring"><bpmndi:BPMNPlane id="Plane_CustomTailoring" bpmnElement="CustomTailoring"><bpmndi:BPMNShape id="start2_di" bpmnElement="start2"><dc:Bounds x="40" y="170" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="request_di" bpmnElement="request"><dc:Bounds x="135" y="150" width="130" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="quote_di" bpmnElement="quote"><dc:Bounds x="335" y="150" width="130" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="approve_di" bpmnElement="approve"><dc:Bounds x="540" y="160" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="reject_di" bpmnElement="reject"><dc:Bounds x="660" y="290" width="130" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="cancelled_di" bpmnElement="cancelled"><dc:Bounds x="870" y="310" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="confirmed_di" bpmnElement="confirmed"><dc:Bounds x="660" y="150" width="130" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="produce_di" bpmnElement="produce"><dc:Bounds x="850" y="150" width="130" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="handoff_di" bpmnElement="handoff"><dc:Bounds x="1040" y="150" width="130" height="76" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="done_di" bpmnElement="done"><dc:Bounds x="1230" y="170" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="t1_di" bpmnElement="t1"><di:waypoint x="76" y="188.0" /><di:waypoint x="135" y="188.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="t2_di" bpmnElement="t2"><di:waypoint x="265" y="188.0" /><di:waypoint x="335" y="188.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="t3_di" bpmnElement="t3"><di:waypoint x="465" y="188.0" /><di:waypoint x="540" y="185.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="t4_di" bpmnElement="t4"><di:waypoint x="590" y="185.0" /><di:waypoint x="660" y="328.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="t5_di" bpmnElement="t5"><di:waypoint x="790" y="328.0" /><di:waypoint x="870" y="328.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="t6_di" bpmnElement="t6"><di:waypoint x="590" y="185.0" /><di:waypoint x="660" y="188.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="t7_di" bpmnElement="t7"><di:waypoint x="790" y="188.0" /><di:waypoint x="850" y="188.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="t8_di" bpmnElement="t8"><di:waypoint x="980" y="188.0" /><di:waypoint x="1040" y="188.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="t9_di" bpmnElement="t9"><di:waypoint x="1170" y="188.0" /><di:waypoint x="1230" y="188.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>